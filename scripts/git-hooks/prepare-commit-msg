#!/usr/bin/env bash
# Cursor injects Co-authored-by before commit-msg; strip as early as possible.
set -euo pipefail
root="$(cd "$(dirname "$0")/../.." && pwd)"
# shellcheck source=scripts/git-hooks/strip-ai-attribution.sh
source "$root/scripts/git-hooks/strip-ai-attribution.sh"

msg_file="${1:?commit message file}"
strip_ai_attribution "$msg_file"
exit 0
