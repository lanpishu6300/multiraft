#!/usr/bin/env bash
# Strip editor/AI Co-authored-by trailers (Cursor injects these), then refuse leftovers.
set -euo pipefail
msg_file="${1:?commit message file}"

tmp="$(mktemp)"
grep -Eiv \
  '^[[:space:]]*Co-authored-by:[[:space:]]*(Cursor|GitHub[[:space:]]+Copilot|ChatGPT|Claude|OpenAI|Anthropic|Copilot)' \
  "$msg_file" > "$tmp" || true
mv "$tmp" "$msg_file"

if grep -Eiq \
  '^[[:space:]]*Co-authored-by:[[:space:]]*(Cursor|GitHub[[:space:]]+Copilot|ChatGPT|Claude|OpenAI|Anthropic|Copilot)' \
  "$msg_file"
then
  echo "commit-msg: refuse AI/editor Co-authored-by trailers (Cursor, Copilot, ChatGPT, …)" >&2
  exit 1
fi

if grep -Eiq \
  'Generated by[[:space:]]+(Cursor|ChatGPT|Claude|Copilot)|Made with[[:space:]]+Cursor|Signed-off-by:[[:space:]]*Cursor' \
  "$msg_file"
then
  echo "commit-msg: refuse AI/editor attribution lines in the commit message" >&2
  exit 1
fi

exit 0
